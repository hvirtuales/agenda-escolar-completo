# Copie este archivo como /docker/db-compartida/.env y ponga una clave larga y aleatoria:
#   openssl rand -base64 24 | tr -d '/+='
# Es la clave de root de la base compartida: los proyectos NO la usan (cada uno tiene su usuario, ver crear-base.sh).
# Solo se lee la primera vez que arranca la base; después no se cambia desde aquí.
DB_ROOT_PASSWORD=
