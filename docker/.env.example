# Copie este archivo como docker/.env y cambie las contraseñas. docker/.env no se sube a git.

# Dirección pública de la plataforma (la propone el instalador)
APP_URL=https://agendaescolar.co/

# Red de Docker del Caddy que ya corre en el VPS (la ve con: docker inspect ai-specialists-caddy-1 --format "{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}")
PROXY_NETWORK=ai-specialists_default

# IPs o redes del proxy, separadas por comas. Solo a ellas se les cree la IP real del usuario y que la conexión es HTTPS.
# Lo más estricto: la subred de PROXY_NETWORK (docker network inspect <red> --format "{{(index .IPAM.Config 0).Subnet}}").
# 172.16.0.0/12 cubre cualquier red de Docker.
TRUSTED_PROXIES=172.16.0.0/12

# Modo de base de datos:
#  - Sin COMPOSE_FILE: la app trae su propia MariaDB (docker-compose.yml).
#  - Con la MariaDB compartida del VPS (docker/db-compartida/), descomente:
# COMPOSE_FILE=docker-compose.externa.yml
# Red de la base compartida (solo en ese modo)
DB_NETWORK=db-compartida

# Base de datos propia (en el instalador: servidor «agenda-escolar-db», puerto 3306, y estos datos).
# Se conservan aunque use la base compartida: sirven para volver atrás (migrar-a-db-compartida.sh --revertir).
DB_NAME=educai
DB_USER=educai
DB_PASSWORD=cambie-esta-clave
DB_ROOT_PASSWORD=cambie-esta-otra-clave

# 1 = aplicar migraciones pendientes al arrancar (útil al actualizar la imagen)
AUTO_MIGRATE=0
