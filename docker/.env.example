# Configuración de Docker para Agenda Escolar. instalar.sh crea docker/.env a partir de este archivo.
# docker/.env no se sube a git.

# Dirección pública de la plataforma (la propone el instalador)
APP_URL=https://agendaescolar.co/

# Red de Docker del Caddy que ya corre en el VPS (instalar.sh la detecta sola)
PROXY_NETWORK=ai-specialists_default

# IPs o redes del proxy, separadas por comas. Solo a ellas se les cree la IP real del usuario y que la conexión es HTTPS.
# 172.16.0.0/12 cubre cualquier red de Docker.
TRUSTED_PROXIES=172.16.0.0/12

# Base de datos compartida (docker/db-compartida): red, base y usuario (los crea db-compartida/crear-base.sh)
DB_NETWORK=db-compartida
DB_NAME=educai
DB_USER=educai

# 1 = aplicar migraciones pendientes al arrancar (útil al actualizar)
AUTO_MIGRATE=0

# ---- Solo si usa la alternativa con MariaDB propia (docker-compose.db-propia.yml) ----
# COMPOSE_FILE=docker-compose.db-propia.yml
# DB_PASSWORD=
# DB_ROOT_PASSWORD=
