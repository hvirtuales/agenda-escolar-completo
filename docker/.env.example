# Copie este archivo como docker/.env y cambie las contraseñas. docker/.env no se sube a git.

# Dirección pública de la plataforma (la propone el instalador)
APP_URL=https://agendaescolar.co/

# Dónde escucha el contenedor: solo en este servidor (127.0.0.1); el proxy con el certificado reenvía a http://127.0.0.1:8080
APP_BIND=127.0.0.1
APP_PORT=8080

# IPs o redes del proxy, separadas por comas. Solo a ellas se les cree la IP real del usuario y que la conexión es HTTPS.
# 172.16.0.0/12 = red interna de Docker (proxy instalado en este mismo servidor). Con Cloudflare u otro balanceador, agregue sus redes.
TRUSTED_PROXIES=172.16.0.0/12

# Base de datos (en el instalador: servidor «db», puerto 3306, y estos datos)
DB_NAME=educai
DB_USER=educai
DB_PASSWORD=cambie-esta-clave
DB_ROOT_PASSWORD=cambie-esta-otra-clave

# 1 = aplicar migraciones pendientes al arrancar (útil al actualizar la imagen)
AUTO_MIGRATE=0
